{
	"name": "editmd-gpuix",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"start": "gpuix-svelte app.ts",
		"test": "vitest run --project unit --project ui --project e2e",
		"build": "bun build.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/browser/tsconfig.json && svelte-check --diagnostic-sources js,svelte --fail-on-warnings",
		"lint": "prettier --check . && eslint . && knip && svelte-check --diagnostic-sources js,svelte --fail-on-warnings",
		"format": "prettier --write .",
		"test:unit": "vitest --project unit",
		"test:coverage": "vitest run --project unit --coverage",
		"visual:review": "vitest --ui --project 'visual-*'",
		"visual:measure": "node node_modules/gpuix-svelte/bin/gpuix-svelte.js test/visual/measure.ts test/visual/out/measurements.json",
		"lint:prettier": "prettier --check .",
		"lint:eslint": "eslint .",
		"lint:knip": "knip",
		"lint:svelte": "svelte-check --diagnostic-sources js,svelte --fail-on-warnings",
		"dev": "gpuix-svelte app.ts",
		"test:ui": "vitest run --project ui",
		"test:e2e": "vitest run --project e2e",
		"test:e2e:window": "EDITMD_E2E_ENTRY=standalone.ts vitest run --project e2e",
		"test:ci": "vitest run --project unit --coverage && vitest run --project ui",
		"test:visual": "vitest run --project 'visual-*'"
	},
	"dependencies": {
		"gpuix-svelte": "0.4.1",
		"pele": "1.13.0",
		"satteri": "0.11.6",
		"yjs": "13.6.33"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@gpuix/native": "0.11.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "5.1.0",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/ui": "5.1.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"fast-check": "4.10.2",
		"globals": "^17.14.0",
		"knip": "6.44.1",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.8",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0"
	}
}
