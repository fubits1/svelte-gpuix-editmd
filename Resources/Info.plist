<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  adapted from kirahowe/editmd@9e889e6 Resources/Info.plist: own name and identifier, no NSDocument classes.
  editmd's CFBundleDocumentTypes (Markdown and plain text, LSHandlerRank Alternate) and its imported
  net.daringfireball.markdown UTI are left out until gap G6 lands: Finder and `open -a` hand a .app its
  documents as an Apple Event, which gpuix does not handle, so a registered type opened an empty window
  (checked 2026-10-25, docs/adr/0009). Copy them back from editmd's Info.plist then.
-->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>editmd-gpuix</string>
	<key>CFBundleDisplayName</key>
	<string>editmd-gpuix</string>
	<key>CFBundleExecutable</key>
	<string>editmd-gpuix</string>
	<key>CFBundleIdentifier</key>
	<string>dev.gpuix.editmd</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>A small markdown editor, ported from editmd.</string>
</dict>
</plist>
